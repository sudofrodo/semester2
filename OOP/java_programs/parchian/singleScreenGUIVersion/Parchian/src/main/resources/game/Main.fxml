<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="game.SceneController">
   <children>
      <Label layoutX="298.0" layoutY="214.0" prefHeight="70.0" prefWidth="325.0" text="      Hi, Welcome to Parchian">
         <font>
            <Font name="System Bold" size="22.0" />
         </font>
      </Label>
      <Button fx:id="startGame" layoutX="288.0" layoutY="311.0" mnemonicParsing="false" onAction="#switchToPointsScene" prefHeight="39.0" prefWidth="116.0" text="Start Game">
         <font>
            <Font size="15.0" />
         </font>
      </Button>
      <Button fx:id="gameRules" layoutX="513.0" layoutY="311.0" mnemonicParsing="false" prefHeight="39.0" prefWidth="134.0" text="Game Rules">
         <font>
            <Font size="15.0" />
         </font>
      </Button>
      <Button fx:id="exit" layoutX="410.0" layoutY="382.0" mnemonicParsing="false" prefHeight="39.0" prefWidth="80.0" text="Exit">
         <font>
            <Font size="14.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
